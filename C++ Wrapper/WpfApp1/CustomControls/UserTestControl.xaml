<model:NotifyPropertyChangedUserControl  
             xmlns:model="clr-namespace:GraphApp.Model"
             x:Class="GraphApp.CustomControls.UserTestControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphApp.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Label Content="Row1." />
        <Label Content="{Binding }"  Grid.Row="1"/>
        <Label Content="Row3." Grid.Row="2" />
        
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
    </Grid>
</model:NotifyPropertyChangedUserControl>
