<UserControl  
             xmlns:model="clr-namespace:GraphApp.Model"
             x:Class="GraphApp.UserControls.UserTestControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <TextBox VerticalScrollBarVisibility="Visible"                            
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     IsReadOnly="False"
                     IsEnabled="True"
                     Text="{Binding Path=TextCommon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox AcceptsReturn="True" Grid.Row="1" Text="{Binding Path=TextLocal, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <Label Content="Label:"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Label Content="{Binding Path=TextLocal, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
